generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id Int @id @default(autoincrement())
  libelle String @db.VarChar(50)

  utilisateurs Utilisateur[]
}

model Utilisateur {
  utilisateur_id Int @id @default(autoincrement())
  email          String @unique @db.VarChar(50)
  password       String @db.VarChar(255)
  prenom         String @db.VarChar(50)
  nom            String @db.VarChar(50)
  telephone      String @db.VarChar(50)
  ville          String @db.VarChar(50)
  pays           String @db.VarChar(50)
  adresse_postale String @db.VarChar(50)

  actif Boolean @default(true)
  
  role_id Int
  role    Role @relation(fields: [role_id], references: [role_id])

  resetTokens PasswordResetToken[]
  commandes Commande[]
  avis      Avis[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime

  utilisateur_id Int
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model MenuImage {
  image_id Int @id @default(autoincrement())
  url      String @db.VarChar(255)
  type     String @db.VarChar(50)
  ordre    Int

  menu_id Int
  menu    Menu @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade)
}

model Avis {
  avis_id     Int @id @default(autoincrement())
  note        Int
  description String @db.VarChar(255)
  statut      String @db.VarChar(50)
  createdAt   DateTime @default(now())

  utilisateur_id Int
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])
}

model Commande {
  commande_id        Int @id @default(autoincrement())
  numero_commande    String @unique @db.VarChar(50)
  date_commande      DateTime
  date_prestation    DateTime
  heure_livraison    String @db.VarChar(50)
  prix_menu          Float
  nombre_personne    Int
  prix_livraison     Float
  statut             String @db.VarChar(50)
  pret_materiel      Boolean
  restitution_materiel Boolean

  utilisateur_id Int
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])

  statusHistory OrderStatusHistory[]

  menu_id Int
  menu    Menu @relation(fields: [menu_id], references: [menu_id])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  status    String   @db.VarChar(50)
  createdAt DateTime @default(now())

  orderId Int
  order   Commande @relation(fields: [orderId], references: [commande_id], onDelete: Cascade)
}

model Menu {
  menu_id                 Int @id @default(autoincrement())
  titre                   String @db.VarChar(50)
  nombre_personne_minimum Int
  prix_par_personne       Float
  regime                  String @db.VarChar(50)
  description             String @db.VarChar(255)
  conditions              String? @db.VarChar(255)
  quantite_restante       Int

  regime_id Int
  regimeRelation Regime @relation(fields: [regime_id], references: [regime_id])

  theme_id Int
  theme    Theme @relation(fields: [theme_id], references: [theme_id])

  images MenuImage[]
  plats     MenuPlat[]
  commandes Commande[]
}

model Theme {
  theme_id Int @id @default(autoincrement())
  libelle  String @db.VarChar(50)

  menus Menu[]
}

model Regime {
  regime_id Int @id @default(autoincrement())
  libelle   String @db.VarChar(50)

  menus Menu[]
}

model Plat {
  plat_id    Int @id @default(autoincrement())
  titre_plat String @db.VarChar(50)
  type       String @db.VarChar(50) // entree, plat, dessert
  photo      Bytes?

  menus      MenuPlat[]
  allergenes PlatAllergene[]
}

model MenuPlat {
  menu_id Int
  plat_id Int

  menu Menu @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade)
  plat Plat @relation(fields: [plat_id], references: [plat_id], onDelete: Cascade)

  @@id([menu_id, plat_id])
}

model Allergene {
  allergene_id Int @id @default(autoincrement())
  libelle      String @db.VarChar(50)

  plats PlatAllergene[]
}

model PlatAllergene {
  plat_id      Int
  allergene_id Int

  plat      Plat @relation(fields: [plat_id], references: [plat_id], onDelete: Cascade)
  allergene Allergene @relation(fields: [allergene_id], references: [allergene_id], onDelete: Cascade)

  @@id([plat_id, allergene_id])
}

model Horaire {
  horaire_id      Int @id @default(autoincrement())
  jour            String @db.VarChar(50)
  heure_ouverture String @db.VarChar(50)
  heure_fermeture String @db.VarChar(50)
}